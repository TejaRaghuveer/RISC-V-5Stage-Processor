// RISC-V ADDI Test Program (Machine Code)
// Tests immediate arithmetic operations (ADDI with positive/negative immediates)
// Format: One 32-bit instruction per line (8 hex digits)

// ============================================
// Section 1: Initialize Base Values
// ============================================
00A00093  // ADDI x1, x0, 10         (x1 = 10)
00500113  // ADDI x2, x0, 5          (x2 = 5)
00000193  // ADDI x3, x0, 0          (x3 = 0)
7FFFF217  // LUI x4, 0x7FFFF         (x4 = 0x7FFFF000)
FFF22213  // ADDI x4, x4, 0xFFF      (x4 = 0x7FFFFFFF)
80000297  // LUI x5, 0x80000         (x5 = 0x80000000)

// ============================================
// Section 2: ADDI with Positive Immediates
// ============================================
00508093  // ADDI x10, x1, 5         (x10 = 10 + 5 = 15)
00008093  // ADDI x11, x1, 0         (x11 = 10 + 0 = 10)
02A00113  // ADDI x12, x0, 42        (x12 = 0 + 42 = 42)
00108093  // ADDI x13, x1, 1         (x13 = 10 + 1 = 11)
7FF08113  // ADDI x14, x1, 2047      (x14 = 10 + 2047 = 2057)

// ============================================
// Section 3: ADDI with Negative Immediates (acts as SUBI)
// ============================================
FFB08113  // ADDI x20, x1, -5        (x20 = 10 + (-5) = 5)
FF608193  // ADDI x21, x1, -10       (x21 = 10 + (-10) = 0)
FFF08193  // ADDI x22, x1, -1        (x22 = 10 + (-1) = 9)
FFD10193  // ADDI x23, x2, -3        (x23 = 5 + (-3) = 2)
FFF00213  // ADDI x24, x0, -1        (x24 = 0 + (-1) = -1)
80010213  // ADDI x25, x0, -2048     (x25 = 0 + (-2048) = -2048)

// ============================================
// Section 4: ADDI with Large Positive Values
// ============================================
00020213  // ADDI x30, x4, 0         (x30 = 0x7FFFFFFF + 0 = 0x7FFFFFFF)
FFF20293  // ADDI x31, x4, -1        (x31 = 0x7FFFFFFF + (-1) = 0x7FFFFFFE)

// ============================================
// Section 5: ADDI with Large Negative Values
// ============================================
00028293  // ADDI x28, x5, 0         (x28 = 0x80000000 + 0 = 0x80000000)
00128313  // ADDI x29, x5, 1         (x29 = 0x80000000 + 1 = 0x80000001)

// ============================================
// Section 6: ADDI Overflow Cases
// ============================================
00120313  // ADDI x6, x4, 1          (x6 = 0x7FFFFFFF + 1 = 0x80000000)
7FF20393  // ADDI x7, x4, 2047       (x7 = 0x7FFFFFFF + 2047 = 0x800007FE)
FFF28393  // ADDI x8, x5, -1         (x8 = 0x80000000 + (-1) = 0x7FFFFFFF)

// ============================================
// Section 7: ADDI Edge Cases
// ============================================
00018193  // ADDI x15, x3, 0         (x15 = 0 + 0 = 0)
00118193  // ADDI x16, x3, 1         (x16 = 0 + 1 = 1)
FFF18193  // ADDI x17, x3, -1        (x17 = 0 + (-1) = -1)
FF608193  // ADDI x18, x1, -10       (x18 = 10 + (-10) = 0)
FF508193  // ADDI x19, x1, -11       (x19 = 10 + (-11) = -1)

// ============================================
// Section 8: Store Results for Verification
// ============================================
00A02023  // SW x10, 0(x0)           (memory[0] = 15)
00B02223  // SW x11, 4(x0)           (memory[1] = 10)
00C02423  // SW x12, 8(x0)           (memory[2] = 42)
00D02623  // SW x13, 12(x0)          (memory[3] = 11)
00E02823  // SW x14, 16(x0)          (memory[4] = 2057)
01402A23  // SW x20, 20(x0)          (memory[5] = 5)
01502C23  // SW x21, 24(x0)          (memory[6] = 0)
01602E23  // SW x22, 28(x0)          (memory[7] = 9)
01702023  // SW x23, 32(x0)          (memory[8] = 2)
01802223  // SW x24, 36(x0)          (memory[9] = -1)
01902423  // SW x25, 40(x0)          (memory[10] = -2048)
00602623  // SW x6, 44(x0)           (memory[11] = 0x80000000)
00702823  // SW x7, 48(x0)           (memory[12] = 0x800007FE)
00802A23  // SW x8, 52(x0)           (memory[13] = 0x7FFFFFFF)
00F02C23  // SW x15, 56(x0)          (memory[14] = 0)
01002E23  // SW x16, 60(x0)          (memory[15] = 1)
01102023  // SW x17, 64(x0)          (memory[16] = -1)
01202223  // SW x18, 68(x0)          (memory[17] = 0)
01302423  // SW x19, 72(x0)          (memory[18] = -1)

// ============================================
// Section 9: Self-Checking Verification
// ============================================
00002083  // LW x1, 0(x0)            (Load result)
00F00113  // ADDI x2, x0, 15         (Expected value)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00302C23  // SW x3, 76(x0)           (Store comparison)
01402083  // LW x1, 20(x0)           (Load result)
00500113  // ADDI x2, x0, 5          (Expected value)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00302E23  // SW x3, 80(x0)           (Store comparison)
02402083  // LW x1, 36(x0)           (Load result)
FFF00113  // ADDI x2, x0, -1         (Expected value)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00303023  // SW x3, 84(x0)           (Store comparison)
02C02083  // LW x1, 44(x0)           (Load overflow result)
80000137  // LUI x2, 0x80000         (Expected: 0x80000000)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00303223  // SW x3, 88(x0)           (Store comparison)

// ============================================
// End Marker
// ============================================
00000013  // ADDI x0, x0, 0          (NOP)
00000013  // ADDI x0, x0, 0          (NOP)

