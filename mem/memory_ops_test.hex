// RISC-V Memory Operations Test Program (Machine Code)
// Tests: Basic load/store, load-use hazards, store-load forwarding, addressing with offsets
// Format: One 32-bit instruction per line (8 hex digits)

// ============================================
// Section 1: Initialize Test Data in Memory
// ============================================
12345097  // LUI x1, 0x12345          (x1 = 0x12345000)
67808093  // ADDI x1, x1, 0x678       (x1 = 0x12345678)
00102023  // SW x1, 0(x0)             (memory[0] = 0x12345678)

ABCDE117  // LUI x2, 0xABCDE          (x2 = 0xABCDE000)
F0010113  // ADDI x2, x2, 0xF00       (x2 = 0xABCDEF00)
00202223  // SW x2, 4(x0)            (memory[1] = 0xABCDEF00)

04200193  // ADDI x3, x0, 0x42        (x3 = 0x00000042)
00302423  // SW x3, 8(x0)            (memory[2] = 0x00000042)

FFF00213  // ADDI x4, x0, -1          (x4 = 0xFFFFFFFF)
00402623  // SW x4, 12(x0)           (memory[3] = 0xFFFFFFFF)

00000293  // ADDI x5, x0, 0           (x5 = 0x00000000)
00502823  // SW x5, 16(x0)           (memory[4] = 0x00000000)

11111317  // LUI x6, 0x11111          (x6 = 0x11111000)
11130313  // ADDI x6, x6, 0x111       (x6 = 0x11111111)
00602A23  // SW x6, 20(x0)           (memory[5] = 0x11111111)

22222397  // LUI x7, 0x22222          (x7 = 0x22222000)
22238393  // ADDI x7, x7, 0x222       (x7 = 0x22222222)
00702C23  // SW x7, 24(x0)           (memory[6] = 0x22222222)

33333417  // LUI x8, 0x33333          (x8 = 0x33333000)
33340413  // ADDI x8, x8, 0x333       (x8 = 0x33333333)
00802E23  // SW x8, 28(x0)           (memory[7] = 0x33333333)

// ============================================
// Section 2: Basic Load Operations (LW)
// ============================================
00002503  // LW x10, 0(x0)           (x10 = memory[0] = 0x12345678)
00402583  // LW x11, 4(x0)           (x11 = memory[1] = 0xABCDEF00)
00802603  // LW x12, 8(x0)           (x12 = memory[2] = 0x00000042)
00C02683  // LW x13, 12(x0)          (x13 = memory[3] = 0xFFFFFFFF)
01002703  // LW x14, 16(x0)          (x14 = memory[4] = 0x00000000)
01402783  // LW x15, 20(x0)          (x15 = memory[5] = 0x11111111)
01802803  // LW x16, 24(x0)          (x16 = memory[6] = 0x22222222)
01C02883  // LW x17, 28(x0)          (x17 = memory[7] = 0x33333333)

// ============================================
// Section 3: Basic Store Operations (SW)
// ============================================
DEAD0093  // ADDI x18, x0, 0xDEAD    (x18 = 0x0000DEAD)
01009913  // SLLI x18, x18, 16        (x18 = 0xDEAD0000)
BEEF0093  // ADDI x19, x0, 0xBEEF    (x19 = 0x0000BEEF)
0139E933  // OR x18, x18, x19         (x18 = 0xDEADBEEF)
01202023  // SW x18, 32(x0)          (memory[8] = 0xDEADBEEF)

CAFE0093  // ADDI x19, x0, 0xCAFE    (x19 = 0x0000CAFE)
01009993  // SLLI x19, x19, 16        (x19 = 0xCAFE0000)
BABE00A3  // ADDI x20, x0, 0xBABE    (x20 = 0x0000BABE)
0149EA33  // OR x19, x19, x20         (x19 = 0xCAFEBABE)
01302223  // SW x19, 36(x0)          (memory[9] = 0xCAFEBABE)

123400A3  // ADDI x20, x0, 0x1234    (x20 = 0x00001234)
01402423  // SW x20, 40(x0)          (memory[10] = 0x00001234)

FFF00AA3  // ADDI x21, x0, -1         (x21 = 0xFFFFFFFF)
01502623  // SW x21, 44(x0)          (memory[11] = 0xFFFFFFFF)

// ============================================
// Section 4: Memory Addressing with Offsets
// ============================================
03000B13  // ADDI x22, x0, 48         (x22 = base address offset)
0000BB83  // LW x23, 0(x22)          (x23 = memory[12])
0040BC03  // LW x24, 4(x22)          (x24 = memory[13])
0080BC83  // LW x25, 8(x22)          (x25 = memory[14])
00C0BD03  // LW x26, 12(x22)         (x26 = memory[15])

04000D93  // ADDI x27, x0, 64         (x27 = 64)
FFCD8D13  // ADDI x28, x27, -4        (x28 = 60)
0000DE83  // LW x28, 0(x28)          (x28 = memory[15])

00000F13  // ADDI x30, x0, 0          (x30 = base address 0)
01C02F83  // LW x31, 28(x30)         (x31 = memory[7])

// ============================================
// Section 5: Load-Use Hazard Test
// ============================================
00002083  // LW x1, 0(x0)            (x1 = memory[0] = 0x12345678 - LOAD)
00008133  // ADD x2, x1, x0           (x2 = x1 + 0 - USE, should stall)
00203023  // SW x2, 48(x0)           (memory[12] = x2)

00402183  // LW x3, 4(x0)            (x3 = memory[1] = 0xABCDEF00 - LOAD)
000181B3  // SUB x4, x3, x0           (x4 = x3 - 0 - USE, should stall)
00403223  // SW x4, 52(x0)           (memory[13] = x4)

00802283  // LW x5, 8(x0)            (x5 = memory[2] = 0x00000042 - LOAD)
0052F333  // AND x6, x5, x5           (x6 = x5 & x5 - USE, should stall)
00603323  // SW x6, 56(x0)           (memory[14] = x6)

00C02383  // LW x7, 12(x0)           (x7 = memory[3] = 0xFFFFFFFF - LOAD)
0073E433  // OR x8, x7, x0            (x8 = x7 | 0 - USE, should stall)
00803423  // SW x8, 60(x0)           (memory[15] = x8)

// ============================================
// Section 6: Store-Load Forwarding Test
// ============================================
55550093  // ADDI x9, x0, 0x5555      (x9 = 0x00005555)
01009493  // SLLI x9, x9, 16          (x9 = 0x55550000)
AAAA00A3  // ADDI x10, x0, 0xAAAA     (x10 = 0x0000AAAA)
00A4E533  // OR x9, x9, x10           (x9 = 0x5555AAAA)
00904023  // SW x9, 64(x0)           (memory[16] = 0x5555AAAA - STORE)
04004583  // LW x11, 64(x0)           (x11 = memory[16] - LOAD)
00B04223  // SW x11, 68(x0)          (memory[17] = x11)

77770093  // ADDI x12, x0, 0x7777     (x12 = 0x00007777)
01009613  // SLLI x12, x12, 16        (x12 = 0x77770000)
88880093  // ADDI x13, x0, 0x8888     (x13 = 0x00008888)
00D66633  // OR x12, x12, x13         (x12 = 0x77778888)
04000713  // ADDI x14, x0, 64         (x14 = base address)
00C72023  // SW x12, 0(x14)          (memory[16] = 0x77778888 - STORE)
00072783  // LW x15, 0(x14)          (x15 = memory[16] - LOAD)
00F04423  // SW x15, 72(x0)          (memory[18] = x15)

99990093  // ADDI x16, x0, 0x9999     (x16 = 0x00009999)
01009813  // SLLI x16, x16, 16        (x16 = 0x99990000)
AAAA0093  // ADDI x17, x0, 0xAAAA     (x17 = 0x0000AAAA)
01186833  // OR x16, x16, x17         (x16 = 0x9999AAAA)
05000913  // ADDI x18, x0, 80         (x18 = base address)
01092023  // SW x16, 0(x18)          (memory[20] = 0x9999AAAA - STORE)
00092983  // LW x19, 0(x18)          (x19 = memory[20] - LOAD)
01304C23  // SW x19, 88(x0)          (memory[22] = x19 - store-load forwarding)

// ============================================
// Section 7: Store Results for Verification
// ============================================
00A06023  // SW x10, 96(x0)          (memory[24] = 0x12345678)
00B06223  // SW x11, 100(x0)         (memory[25] = 0xABCDEF00)
00C06423  // SW x12, 104(x0)         (memory[26] = 0x00000042)
00D06623  // SW x13, 108(x0)         (memory[27] = 0xFFFFFFFF)

01707023  // SW x23, 112(x0)         (memory[28] = offset addressing result)
01807223  // SW x24, 116(x0)         (memory[29] = offset addressing result)
01C07823  // SW x28, 120(x0)         (memory[30] = negative offset simulation)
01F07A23  // SW x31, 124(x0)         (memory[31] = large offset)

// ============================================
// Section 8: Self-Checking Verification
// ============================================
03002083  // LW x1, 48(x0)           (Load result from load-use test 1)
12345097  // LUI x2, 0x12345         (Expected: 0x12345000)
67810113  // ADDI x2, x2, 0x678      (Expected: 0x12345678)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00308023  // SW x3, 128(x0)         (memory[32] = comparison result)

04402083  // LW x1, 68(x0)           (Load result from store-load test 1)
55555097  // LUI x2, 0x5555          (Expected: 0x55550000)
AAA10113  // ADDI x2, x2, 0xAAAA     (Expected: 0x5555AAAA)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00308223  // SW x3, 132(x0)         (memory[33] = comparison result)

06002083  // LW x1, 96(x0)           (Load verification result)
12345097  // LUI x2, 0x12345         (Expected: 0x12345000)
67810113  // ADDI x2, x2, 0x678      (Expected: 0x12345678)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00308423  // SW x3, 136(x0)         (memory[34] = comparison result)

// ============================================
// End Marker
// ============================================
00000013  // ADDI x0, x0, 0           (NOP)
00000013  // ADDI x0, x0, 0           (NOP)

