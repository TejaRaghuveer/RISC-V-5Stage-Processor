// RISC-V ADD/SUB Test Program (Machine Code)
// Tests arithmetic operations with positive/negative numbers and overflow cases
// Format: One 32-bit instruction per line (8 hex digits)

// ============================================
// Section 1: Initialize Test Values
// ============================================
00500093  // ADDI x1, x0, 5          (x1 = 5)
00300113  // ADDI x2, x0, 3          (x2 = 3)
FFB00193  // ADDI x3, x0, -5         (x3 = -5, sign-extended)
FFD00213  // ADDI x4, x0, -3         (x4 = -3, sign-extended)
7FFFF297  // LUI x5, 0x7FFFF         (x5 = 0x7FFFF000)
FFF28293  // ADDI x5, x5, 0xFFF      (x5 = 0x7FFFFFFF)
80000317  // LUI x6, 0x80000         (x6 = 0x80000000)
00000393  // ADDI x7, x0, 0          (x7 = 0)
00100413  // ADDI x8, x0, 1          (x8 = 1)

// ============================================
// Section 2: Basic ADD Operations
// ============================================
00208533  // ADD x10, x1, x2         (x10 = 5 + 3 = 8)
004186B3  // ADD x11, x3, x4         (x11 = -5 + (-3) = -8)
00308733  // ADD x12, x1, x3         (x12 = 5 + (-5) = 0)
004087B3  // ADD x13, x1, x4         (x13 = 5 + (-3) = 2)
00218833  // ADD x14, x3, x2         (x14 = -5 + 3 = -2)
001088B3  // ADD x15, x1, x7         (x15 = 5 + 0 = 5)
00308933  // ADD x16, x3, x7         (x16 = -5 + 0 = -5)

// ============================================
// Section 3: Basic SUB Operations
// ============================================
40210133  // SUB x20, x1, x2         (x20 = 5 - 3 = 2)
401101B3  // SUB x21, x2, x1         (x21 = 3 - 5 = -2)
40418233  // SUB x22, x3, x4         (x22 = -5 - (-3) = -2)
40310233  // SUB x23, x1, x3         (x23 = 5 - (-5) = 10)
401182B3  // SUB x24, x3, x1         (x24 = -5 - 5 = -10)
40708333  // SUB x25, x1, x7         (x25 = 5 - 0 = 5)
407101B3  // SUB x26, x2, x7         (x26 = 3 - 0 = 3)

// ============================================
// Section 4: Overflow Cases (ADD)
// ============================================
00828F33  // ADD x30, x5, x8         (x30 = 0x7FFFFFFF + 1 = 0x80000000)
00528FB3  // ADD x31, x5, x5         (x31 = 0x7FFFFFFF + 0x7FFFFFFF = 0xFFFFFFFE)

// ============================================
// Section 5: Overflow Cases (SUB)
// ============================================
40830E33  // SUB x28, x6, x8         (x28 = 0x80000000 - 1 = 0x7FFFFFFF)
40630EB3  // SUB x29, x6, x6         (x29 = 0x80000000 - 0x80000000 = 0)

// ============================================
// Section 6: Store Results for Verification
// ============================================
00A02023  // SW x10, 0(x0)           (memory[0] = 8)
00B02223  // SW x11, 4(x0)           (memory[1] = -8)
00C02423  // SW x12, 8(x0)           (memory[2] = 0)
00D02623  // SW x13, 12(x0)          (memory[3] = 2)
00E02823  // SW x14, 16(x0)          (memory[4] = -2)
01402A23  // SW x20, 20(x0)          (memory[5] = 2)
01502C23  // SW x21, 24(x0)          (memory[6] = -2)
01602E23  // SW x22, 28(x0)          (memory[7] = -2)
01702023  // SW x23, 32(x0)          (memory[8] = 10)
01802223  // SW x24, 36(x0)          (memory[9] = -10)
01E02423  // SW x30, 40(x0)          (memory[10] = 0x80000000)
01F02623  // SW x31, 44(x0)          (memory[11] = 0xFFFFFFFE)
01C02823  // SW x28, 48(x0)          (memory[12] = 0x7FFFFFFF)
01D02A23  // SW x29, 52(x0)          (memory[13] = 0)

// ============================================
// Section 7: Self-Checking Verification
// ============================================
00002083  // LW x1, 0(x0)            (Load result)
00800113  // ADDI x2, x0, 8          (Expected value)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00302C23  // SW x3, 56(x0)           (Store comparison result)
00402083  // LW x1, 4(x0)            (Load result)
FF800113  // ADDI x2, x0, -8         (Expected value)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00302E23  // SW x3, 60(x0)           (Store comparison result)
02802083  // LW x1, 40(x0)           (Load overflow result)
80000137  // LUI x2, 0x80000         (Expected: 0x80000000)
402081B3  // SUB x3, x1, x2          (x3 = 0 if correct)
00303023  // SW x3, 64(x0)           (Store comparison result)

// ============================================
// End Marker
// ============================================
00000013  // ADDI x0, x0, 0          (NOP)
00000013  // ADDI x0, x0, 0          (NOP)

